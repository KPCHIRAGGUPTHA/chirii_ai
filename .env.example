# Copy this file to .env and fill in real values. Never commit .env.

# Signs login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHIRII_SECRET_KEY=replace-with-a-long-random-string

# S5: encrypts every user's memory file. Create it (never shown) with:
#   python -m chirii.app.keys create
# then save a copy in your password manager:  python -m chirii.app.keys show
# If this key is lost, the data cannot be recovered. Do not keep the repo (and so .env) in OneDrive.
CHIRII_DATA_KEY=

# Where users' encrypted memory files are stored: outside the repository and outside OneDrive
CHIRII_DATA_DIR=%LOCALAPPDATA%\Chirii

# Language model server: llama.cpp's llama-server on this machine by default.
# Point this at a GPU server later without changing any code.
CHIRII_LLM_BASE_URL=http://127.0.0.1:8080/v1
CHIRII_LLM_MODEL=qwen2.5-1.5b-instruct-q8_0
CHIRII_LLM_API_KEY=

CHIRII_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Where the embedding model is downloaded to (ignored by git)
CHIRII_EMBED_CACHE_DIR=models/fastembed
CHIRII_LOG_LEVEL=INFO
